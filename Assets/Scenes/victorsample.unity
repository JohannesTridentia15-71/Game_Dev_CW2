  m_Script: {fileID: 11500000, guid: 553a4ab16bd0d451db7ad78b72cec32a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnimalInteractable
  isNeutralNPC: 0
  isMadameHenriette: 0
  animalType: 3
  speakerName: Indiana Bones
  spriteRenderer: {fileID: 584173644}
  normalAnimalSprite: {fileID: -808736545, guid: e918afba78f0d9d4dbf96218318060f2, type: 3}
  gravestoneSprite: {fileID: -25310339, guid: e918afba78f0d9d4dbf96218318060f2, type: 3}
  gravestoneSpeakerName: Gravestone
  disableColliderWhenDefeated: 0
  humbleLines:
  - Dog voice line 1 when low pride
  - Dog voice line 2 when low pride
  proudLines:
  - Word travels fast around the farm. You've been throwing your weight around.
  - Think you're big enough to push me around too?
  arrogantLines:
  - '*Backs away nervously* Look at the size of you... Everyone''s talking about what you did.'
  - Stay back! I won't go down without a fight!
  roosterHeartbrokenLines:
  - Chin up, kid! Wingston may have taken Madame Henriette, but he hasn't broken your spirit.
  - "Focus on my crow and steady your heart\u2014let's train until your strength comes back!"
  heartbrokenRefuseFightLines:
  - "...You look completely broken right now. I'm not fighting you like this\u2014go talk to the Rooster."
  onStartRoosterTraining:
    m_PersistentCalls:
      m_Calls: []
  befriendedLines:
  - '*Snort!* Good to see you again, partner! My Truffle Charm is with you.'
  gravestoneLines:
  - Here lies Calvin Swine. Loved the oak shade and fresh truffles.
  - A wooden marker stands where they used to graze.
  dialogueBox: {fileID: 952051008}
  combatSceneName: Combat
  startBattleAfterDialogue: 1
  interactKey: 101
